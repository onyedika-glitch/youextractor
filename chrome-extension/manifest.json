{
    "manifest_version": 3,
    "name": "YouExtractor",
    "version": "2.0.7",
    "description": "Extract code and tutorials from YouTube videos directly on the page — no leaving YouTube.",
    "permissions": [
        "activeTab",
        "cookies",
        "clipboardWrite"
    ],
    "host_permissions": [
        "*://*.youtube.com/*",
        "https://youextractor.me/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Extract with YouExtractor"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
