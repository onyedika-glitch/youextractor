{
    "manifest_version": 3,
    "name": "YouExtractor",
    "version": "1.2",
    "description": "Extract code and tutorials from YouTube videos directly to YouExtractor.",
    "permissions": [
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Extract with YouExtractor"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}